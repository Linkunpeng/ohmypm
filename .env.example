# Copy to .env (or run scripts/init-env.sh, which generates random secrets).

# PostgreSQL (docker compose)
POSTGRES_USER=ohmypm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ohmypm
OHMYPM_DB_PORT=55432

# Used when running the server on the host (compose overrides it with the in-network URL).
OHMYPM_DATABASE_URL=postgresql+psycopg://ohmypm:change-me@127.0.0.1:55432/ohmypm

# Tokens (long random strings). Admin: Web UI + CLI. Runner: `ohmypm runner start`.
OHMYPM_API_TOKEN=
OHMYPM_RUNNER_TOKEN=
# Optional static token for agents you launch yourself with the ohmypm MCP server configured.
OHMYPM_AGENT_TOKEN=

# URL runners and agents use to reach the server (MCP endpoint = <public_url>/mcp).
# Host port the server is published on (docker compose).
OHMYPM_HOST_PORT=8765
OHMYPM_PUBLIC_URL=http://127.0.0.1:8765

# Agent → agent dispatch depth (0 = agents cannot start runs).
OHMYPM_AGENT_MAX_DISPATCH_DEPTH=0

# Optional build mirrors (e.g. PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn)
PYPI_MIRROR=
NPM_REGISTRY=
