# Environment variables understood by ohmypm (all optional).

# Data directory (database, assets, backups, exports, web token).
# Default: $XDG_DATA_HOME/ohmypm or ~/.local/share/ohmypm
#OHMYPM_DATA_DIR=/home/me/.local/share/ohmypm

# Configuration directory (config.toml, agent-instructions.md).
# Default: $XDG_CONFIG_HOME/ohmypm or ~/.config/ohmypm
#OHMYPM_CONFIG_DIR=/home/me/.config/ohmypm

# Default --author for CLI records.
#OHMYPM_AUTHOR=codex

# Default --project for CLI commands (id, id prefix or name).
#OHMYPM_PROJECT=Robot_WS

# Agent configuration locations used by `ohmypm agents` (same variables the agents use).
#CLAUDE_CONFIG_DIR=~/.claude
#CODEX_HOME=~/.codex
#PI_CODING_AGENT_DIR=~/.pi/agent
#DSH_HOME=~/.dsh
